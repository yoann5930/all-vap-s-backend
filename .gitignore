# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example

# uploads inventaire (photos locales)
/public/uploads/inventory/*
!/public/uploads/inventory/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo

# prisma
prisma/*.db
prisma/*.db-journal

# secrets locaux (identifiants temporaires — jamais committer)
.local/
*credentials*.txt
*credentials*.json
.tmp-*
.tmp-*.json
.tmp-*.txt
.tmp-*.html

# dashboard AVA live — runtime (scores, pas de secrets, ne pas versionner)
tools/ava-live-dashboard/data/

# cache images pour build hash visuel (binaires)
/data/.visual-image-cache/

# sessions de test AVA (isolées, jamais de clients réels)
/data/ava-test-sessions.json
/data/ava-device-registry.json

# sauvegardes inventaire (données employés)
/data/inventaire-backups/

# Android inventaire build (APK publié dans public/apps)
mobile/inventaire-webview/app/build/
mobile/inventaire-webview/.gradle/
mobile/inventaire-webview/local.properties
mobile/ava-device-agent/app/build/
mobile/ava-device-agent/.gradle/
mobile/ava-device-agent/local.properties
mobile/ava-device-agent/*.apk
public/apps/*.apk.idsig
