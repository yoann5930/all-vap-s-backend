generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  EMPLOYEE
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  PREPARED
  SHIPPED
  AT_RELAY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DeliveryMethod {
  MONDIAL_RELAY
  RELAIS_COLIS
  COLISSIMO
  STORE_PICKUP
}

enum PaymentProvider {
  VIVA
  SUMUP
}

enum DiscountType {
  PERCENT
  FIXED
}

enum OrderDocumentType {
  ORDER_FORM
  PREP_SLIP
  DELIVERY_SLIP
  INVOICE
}

enum EmailLogStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  firstName           String?
  lastName            String?
  phone               String?
  role                Role                 @default(CUSTOMER)
  /// Compte actif — false = connexion refusée immédiatement
  active              Boolean              @default(true)
  /// Force le changement de mot de passe (1ère connexion / reset admin)
  mustChangePassword  Boolean              @default(false)
  /// Boutiques inventaire autorisées (codes HAUTMONT / LE_QUESNOY)
  allowedStores       String[]             @default([])
  lastLoginAt         DateTime?
  emailVerified       Boolean              @default(true)
  loyaltyPoints       Int                  @default(0)
  qrCode              String               @unique @default(cuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  orders              Order[]
  addresses           Address[]
  favorites           Favorite[]
  reviews             Review[]
  resetTokens         PasswordResetToken[]
  refreshTokens       RefreshToken[]
  emailConfirmTokens  EmailConfirmationToken[]
  vapeProfile         VapeProfile?
  vapeRecommendations VapeRecommendation[]
  inventorySessions   InventorySession[]
  auditLogs           AuditLog[]
  statusChanges       OrderStatusHistory[] @relation("StatusChangedBy")
}

/// Journal d'audit inventaire / admin (traçabilité obligatoire)
model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail       String?
  userRole        String?
  action          String
  storeCode       String?
  productId       String?
  productName     String?
  inventoryId     String?
  oldQuantity     Int?
  newQuantity     Int?
  sessionId       String?
  deviceInfo      String?
  ip              String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([inventoryId])
  @@index([storeCode, createdAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Manufacturer {
  id                   String                 @id @default(cuid())
  /// Identifiant MASTER (ex. MFR-liquidarom)
  masterId             String?                @unique
  name                 String
  slug                 String                 @unique
  website              String?
  /// URL page marques / gammes officielle
  officialCatalogUrl   String?
  country              String?
  /// verifie | partiel | a_verifier (legacy référentiel)
  status               String                 @default("a_verifier")
  /// OFFICIAL_CONFIRMED | OFFICIAL_NOT_FOUND | NEEDS_CONFIRMATION | INACTIVE | WRONG_MANUFACTURER
  verificationStatus   String                 @default("NEEDS_CONFIRMATION")
  verifiedAt           DateTime?
  /// Preuve JSON (URLs, notes, variantes orthographiques)
  verificationEvidence String?
  sortOrder            Int                    @default(0)
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  brands               Brand[]
  ranges               ProductRange[]
  products             Product[]
  rangeProposals       CatalogRangeProposal[]

  @@index([status])
  @@index([verificationStatus])
}

/// Formats catalogue (10ml, 50ml, 100ml…) — référentiel, pas inventé produit par produit
model CatalogFormat {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  ml        Int?
  /// valide | a_verifier
  status    String   @default("valide")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ml])
}

model Brand {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  logoUrl        String?
  manufacturerId String?
  /// Identifiant MASTER marque (ex. BRD-mamita)
  masterId       String?        @unique
  /// verifie | partiel | a_verifier
  status         String         @default("a_verifier")
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  products       Product[]
  ranges         ProductRange[]
  manufacturer   Manufacturer?  @relation(fields: [manufacturerId], references: [id])

  @@index([manufacturerId])
  @@index([status])
}

/// Gammes extensibles (Ice Cool, Les Collègues, …) — ajoutables sans modifier le code
model ProductRange {
  id                      String                 @id @default(cuid())
  brandId                 String
  manufacturerId          String?
  name                    String
  slug                    String
  /// Identifiant MASTER gamme (ex. RNG-liquidarom-ice_cool)
  masterId                String?                @unique
  /// Codes format déclarés (JSON array string) — ex. ["50ml","10ml"]
  formatCodes             String[]               @default([])
  /// verifie | partiel | a_verifier (legacy)
  status                  String                 @default("a_verifier")
  /// OFFICIAL_CONFIRMED | OFFICIAL_NOT_FOUND | NEEDS_CONFIRMATION | INACTIVE
  /// | WRONG_MANUFACTURER | PRODUCT_NOT_RANGE | NAME_CORRECTION
  verificationStatus      String                 @default("NEEDS_CONFIRMATION")
  /// URL page officielle de la gamme
  officialSourceUrl       String?
  /// URL site / page fabricant prouvant l'appartenance
  officialManufacturerUrl String?
  verifiedAt              DateTime?
  /// Preuve JSON (extraits, URLs, date)
  verificationEvidence    String?
  /// Visible catalogue public uniquement si OFFICIAL_CONFIRMED
  catalogVisible          Boolean                @default(false)
  sortOrder               Int                    @default(0)
  isActive                Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @default(now()) @updatedAt
  products                Product[]
  brand                   Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  manufacturer            Manufacturer?          @relation(fields: [manufacturerId], references: [id])
  proposals               CatalogRangeProposal[]
  collections             ProductCollection[]

  @@unique([brandId, slug])
  @@index([brandId, sortOrder])
  @@index([manufacturerId])
  @@index([status])
  @@index([verificationStatus])
  @@index([catalogVisible])
}

/// Collection / sous-série d'une gamme (ex. Blackout ⊂ Call of Vape).
/// INTERDIT d'afficher une collection comme gamme indépendante.
model ProductCollection {
  id          String       @id @default(cuid())
  rangeId     String
  name        String
  slug        String
  masterId    String?      @unique
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  /// Jamais une route /gammes/[slug] dédiée si false (défaut)
  hasOwnRoute Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  range       ProductRange @relation(fields: [rangeId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([rangeId, slug])
  @@index([rangeId, sortOrder])
}

/// Proposition de gamme (liste Yoann) — base de recherche UNIQUEMENT, jamais intégrée auto
model CatalogRangeProposal {
  id                      String        @id @default(cuid())
  manufacturerId          String
  proposedName            String
  /// yoann | import | autre
  proposedBy              String        @default("yoann")
  /// Statuts de vérification indépendante
  verificationStatus      String        @default("NEEDS_CONFIRMATION")
  officialNameFound       String?
  officialSourceUrl       String?
  officialManufacturerUrl String?
  verifiedAt              DateTime?
  evidenceJson            String?
  notes                   String?
  /// Lié seulement après confirmation + intégration explicite
  integratedRangeId       String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  manufacturer            Manufacturer  @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  integratedRange         ProductRange? @relation(fields: [integratedRangeId], references: [id])

  @@index([manufacturerId, verificationStatus])
  @@index([proposedName])
  @@index([integratedRangeId])
}

/// Photos produit — bouteille seule, statut official | pending | validated
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  /// official | pending | validated
  status    String   @default("pending")
  sortOrder Int      @default(0)
  alt       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([status])
}

/// Métadonnées A.V.A. — invisibles sur le site public
model ProductAvaMeta {
  id                 String   @id @default(cuid())
  productId          String   @unique
  avaKeywords        String?
  avaDescription     String?
  avaRecommendations String?
  avaSaveurs         String?
  avaSimilaires      String?
  avaQuestions       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Product {
  id                    String               @id @default(cuid())
  sku                   String?              @unique
  name                  String
  slug                  String               @unique
  description           String?
  category              String
  brand                 String?
  categoryId            String?
  brandId               String?
  manufacturerId        String?
  imageUrl              String?
  images                String[]             @default([])
  priceCents            Int
  promoPriceCents       Int?
  /// Stock legacy e-commerce (agrégat) — les stocks boutiques sont dans StockLevel
  stock                 Int                  @default(0)
  salesCount            Int                  @default(0)
  isActive              Boolean              @default(true)
  isNew                 Boolean              @default(false)
  isBestSeller          Boolean              @default(false)
  isPromo               Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  /// Nom normalisé pour matching uniquement — jamais affiché tel quel au client
  normalizedName        String?
  subcategory           String?
  range                 String?
  productType           String?
  currency              String               @default("EUR")
  barcode               String?
  sumupProductId        String?
  sumupVariantId        String?
  source                String               @default("manual")
  visibleOnline         Boolean              @default(true)
  /// Cycle de vie catalogue : brut_importe | a_verifier | valide | actif | archive
  catalogStatus         String               @default("a_verifier")
  /// Famille produit dérivée (catégorie SumUp / matching) — aide admin, non publiée
  productFamily         String?
  /// Anomalie détectée à l'import (doublon CSV, sans ID, etc.)
  importAnomaly         String?
  /// Date du dernier import catalogue brut SumUp
  lastCatalogImportAt   DateTime?
  /// Référence fournisseur / interne (distincte du SKU si besoin)
  reference             String?
  shortDescription      String?
  longDescription       String?
  rangeId               String?
  /// Collection / sous-série (ex. Blackout ⊂ Call of Vape) — jamais une gamme indépendante
  collectionId          String?
  /// official | pending | validated
  imageStatus           String               @default("pending")
  sortOrder             Int                  @default(0)
  sumupName             String?
  sumupReference        String?
  sumupSku              String?
  sumupMapping          String?
  sumupLastSync         DateTime?
  /// Contenance en ml (10, 50, 100…) — source de vérité pour offres format
  volumeMl              Int?
  /// Éligible à l'offre 10 ml uniquement (jamais 50/100 ni hors e-liquide)
  promotion10mlEligible Boolean              @default(false)
  favorites             Favorite[]
  orderItems            OrderItem[]
  brandRef              Brand?               @relation(fields: [brandId], references: [id])
  manufacturer          Manufacturer?        @relation(fields: [manufacturerId], references: [id])
  categoryRef           Category?            @relation(fields: [categoryId], references: [id])
  rangeRef              ProductRange?        @relation(fields: [rangeId], references: [id])
  collectionRef         ProductCollection?   @relation(fields: [collectionId], references: [id])
  avaMeta               ProductAvaMeta?
  flavors               ProductFlavor[]
  catalogImages         ProductImage[]
  productMatches        ProductMatch[]       @relation("MatchedProduct")
  variants              ProductVariant[]
  reviews               Review[]
  stockLevels           StockLevel[]
  stockMovements        StockMovement[]
  vapeRecommendations   VapeRecommendation[]
  inventoryLines        InventoryLine[]

  @@index([isActive, visibleOnline, category])
  @@index([isActive, isPromo])
  @@index([isActive, isBestSeller])
  @@index([isActive, isNew])
  @@index([salesCount])
  @@index([categoryId])
  @@index([brandId])
  @@index([manufacturerId])
  @@index([rangeId])
  @@index([collectionId])
  @@index([normalizedName])
  @@index([barcode])
  @@index([reference])
  @@index([sumupProductId])
  @@index([sumupSku])
  @@index([source])
  @@index([sortOrder])
  @@index([isActive, category])
  @@index([catalogStatus])
  @@index([productFamily])
  @@index([lastCatalogImportAt])
  @@index([volumeMl])
  @@index([promotion10mlEligible])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  sku             String?
  barcode         String?
  nicotineMg      Float?
  nicotineLabel   String?
  powerWatts      Float?
  resistanceOhms  Float?
  capacityMl      Float?
  color           String?
  size            String?
  strength        String?
  sumupVariantId  String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]

  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@index([sumupVariantId])
}

model ProductFlavor {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  primaryFlavor    String?
  secondaryFlavor  String?
  flavorFamily     String?
  isFresh          Boolean?
  isFruity         Boolean?
  isGourmet        Boolean?
  isTobacco        Boolean?
  isMint           Boolean?
  isDrink          Boolean?
  confidenceScore  Float?
  validatedManually Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId])
  @@index([flavorFamily])
}

model StockLocation {
  id                 String             @id @default(cuid())
  code               String             @unique
  name               String
  address            String?
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  levels             StockLevel[]
  movements          StockMovement[]
  inventorySessions  InventorySession[]
}

/// Session d'inventaire physique — toujours rattachée à une boutique
/// status: OPEN | COMPLETED | VALIDATED | CORRECTED | CANCELLED
model InventorySession {
  id               String           @id @default(cuid())
  employeeName     String
  locationId       String
  location         StockLocation    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  status           String           @default("OPEN")
  createdByUserId  String?
  createdBy        User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  notes            String?
  startedAt        DateTime         @default(now())
  completedAt      DateTime?
  validatedAt      DateTime?
  validatedByUserId String?
  /// Quand le stock officiel a été appliqué (anti double application)
  stockAppliedAt   DateTime?
  stockAppliedByUserId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lines            InventoryLine[]
  inventoryAudits  InventoryAuditLog[]

  @@index([locationId, status])
  @@index([startedAt])
  @@index([createdByUserId])
  @@index([status, updatedAt])
  @@index([stockAppliedAt])
}

model InventoryLine {
  id                   String           @id @default(cuid())
  sessionId            String
  session              InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId            String?
  barcode              String?
  /// Snapshots catalogue — lisibles même si le produit change ensuite
  productNameSnapshot  String?
  brandSnapshot        String?
  rangeSnapshot        String?
  categorySnapshot     String?
  formatSnapshot       String?
  nicotineSnapshot     String?
  catalogImageUrl      String?
  quantityCounted      Int
  /// Stock théorique boutique au moment du scan (serveur — ne pas faire confiance au client)
  expectedQuantitySnapshot Int?
  unitPriceCents       Int?
  totalValueCents      Int?
  /// CATALOGUE | SUMUP | SAISIE_MANUELLE | CORRECTION_ADMIN
  priceSource          String?
  photoPath            String?
  driveFileId          String?
  syncedToSheetsAt     DateTime?
  notes                String?
  scannedByUserId      String?
  scannedAt            DateTime         @default(now())
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  photos               InventoryPhoto[]
  inventoryAudits      InventoryAuditLog[]

  @@index([sessionId])
  @@index([productId])
  @@index([barcode])
  @@index([scannedAt])
}

/// Photo liée à une ligne d'inventaire (URL persistante en base)
model InventoryPhoto {
  id               String        @id @default(cuid())
  inventoryItemId  String
  line             InventoryLine @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  storageKey       String
  publicUrl        String
  mimeType         String?
  fileSize         Int?
  createdAt        DateTime      @default(now())
  createdById      String?

  @@index([inventoryItemId])
  @@index([createdAt])
}

/// Journal d'audit dédié inventaire (quantités, prix, statut, produit…)
model InventoryAuditLog {
  id               String            @id @default(cuid())
  inventoryId      String
  session          InventorySession  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryItemId  String?
  line             InventoryLine?    @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  userId           String?
  userEmail        String?
  action           String
  fieldName        String?
  oldValue         String?
  newValue         String?
  reason           String?
  createdAt        DateTime          @default(now())

  @@index([inventoryId, createdAt])
  @@index([inventoryItemId])
  @@index([userId, createdAt])
}

model StockLevel {
  id                 String         @id @default(cuid())
  productId          String
  product            Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId          String
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId         String
  location           StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity           Int            @default(0)
  reservedQuantity   Int            @default(0)
  /// availableQuantity = quantity - reservedQuantity (maintenu à l'écriture)
  availableQuantity  Int            @default(0)
  lowStockThreshold  Int            @default(3)
  source             String         @default("unknown")
  lastSyncedAt       DateTime?
  updatedAt          DateTime       @updatedAt
  createdAt          DateTime       @default(now())

  @@unique([variantId, locationId])
  @@index([locationId])
  @@index([productId])
  @@index([availableQuantity])
}

model StockMovement {
  id                String         @id @default(cuid())
  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  locationId        String
  location          StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  movementType      String
  quantityBefore    Int
  quantityChange    Int
  quantityAfter     Int
  source            String
  externalReference String?
  createdAt         DateTime       @default(now())

  @@index([productId, createdAt])
  @@index([locationId, createdAt])
  @@index([movementType])
}

model ProductMatch {
  id                   String    @id @default(cuid())
  sourceType           String
  sourceProductId      String?
  sourceName           String
  normalizedSourceName String
  matchedProductId     String?
  matchedProduct       Product?  @relation("MatchedProduct", fields: [matchedProductId], references: [id], onDelete: SetNull)
  matchMethod          String?
  confidenceScore      Float?
  status               String    @default("UNMATCHED")
  validatedBy          String?
  validatedAt          DateTime?
  locationCode         String?
  syncRunId            String?
  syncRun              SyncRun?  @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  payloadSafe          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([normalizedSourceName])
  @@index([syncRunId])
  @@index([matchedProductId])
}

model SyncRun {
  id              String      @id @default(cuid())
  source          String
  locationCode    String?
  dryRun          Boolean     @default(true)
  startedAt       DateTime    @default(now())
  completedAt     DateTime?
  status          String      @default("RUNNING")
  importedCount   Int         @default(0)
  updatedCount    Int         @default(0)
  unchangedCount  Int         @default(0)
  unmatchedCount  Int         @default(0)
  duplicateCount  Int         @default(0)
  errorCount      Int         @default(0)
  createCount     Int         @default(0)
  errorSummary    String?
  reportJson      String?
  matches         ProductMatch[]
  errors          SyncError[]
}

model SyncError {
  id              String   @id @default(cuid())
  syncRunId       String
  syncRun         SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  sourceRow       Int?
  sourceReference String?
  errorType       String
  errorMessage    String
  payloadSafe     String?
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([syncRunId])
  @@index([resolved])
}

model VapeProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                String    @default("debutant")
  cigarettesPerDay      Int?
  drawPreference        String?
  preferredFlavors      String[]  @default([])
  avoidedFlavors        String[]  @default([])
  advisedNicotineMg     Int?
  usedNicotineMg        Int?
  advisedProductIds     String[]  @default([])
  triedProductIds       String[]  @default([])
  averageBudgetCents    Int?
  gdprConsent           Boolean   @default(false)
  personalizedEnabled   Boolean   @default(true)
  lastRecommendationAt  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model VapeRecommendation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  reason    String
  score     Float?
  source    String   @default("engine")
  createdAt DateTime @default(now())
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Domicile")
  firstName  String
  lastName   String
  street     String
  city       String
  postalCode String
  country    String   @default("FR")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  discountType   DiscountType
  value          Int
  minOrderCents  Int          @default(0)
  maxUses        Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  placement String   @default("home")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EmailConfirmationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Order {
  id                String          @id @default(cuid())
  userId            String?
  user              User?           @relation(fields: [userId], references: [id])
  customerEmail     String
  customerName      String?
  status            OrderStatus     @default(PENDING)
  totalCents        Int
  discountCents     Int             @default(0)
  shippingCents     Int             @default(0)
  couponCode        String?
  deliveryMethod    DeliveryMethod?
  pickupStoreId     String?
  shippingAddress   String?
  trackingNumber    String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  checkoutToken     String?         @unique
  paymentProvider   PaymentProvider?
  sumupCheckoutId   String?         @unique
  sumupPaymentId    String?
  vivaOrderCode     String?         @unique
  vivaTransactionId String?
  loyaltyPointsUsed Int             @default(0)
  loyaltyPointsEarn Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  documents         OrderDocument[]

  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([userId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?
  createdAt   DateTime     @default(now())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User?        @relation("StatusChangedBy", fields: [changedById], references: [id])

  @@index([orderId, createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  priceCents Int
}

model OrderDocument {
  id                String            @id @default(cuid())
  orderId           String
  type              OrderDocumentType
  fileName          String
  storagePath       String
  mimeType          String            @default("application/pdf")
  sizeBytes         Int?
  invoiceNumber     String?
  gmailMessageId    String?
  gmailLabel        String?
  emailedToCustomer Boolean           @default(false)
  emailedInternal   Boolean           @default(false)
  emailedToAva      Boolean           @default(false)
  createdAt         DateTime          @default(now())
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([orderId, type])
  @@index([invoiceNumber])
}

model InvoiceSequence {
  year       Int @id
  lastNumber Int @default(0)
}

/// Journal d'envoi e-mail (PII masquée — pas de corps ni secrets).
model EmailLog {
  id                String         @id @default(cuid())
  type              String
  recipientMasked   String
  subject           String
  relatedOrderId    String?
  relatedCustomerId String?
  idempotencyKey    String?        @unique
  status            EmailLogStatus @default(PENDING)
  attempts          Int            @default(0)
  lastErrorCode     String?
  transport         String?
  sentAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([relatedOrderId])
}
