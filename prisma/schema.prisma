generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DeliveryMethod {
  MONDIAL_RELAY
  RELAIS_COLIS
  COLISSIMO
  STORE_PICKUP
}

enum PaymentProvider {
  VIVA
  SUMUP
}

enum DiscountType {
  PERCENT
  FIXED
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  passwordHash   String
  firstName      String?
  lastName       String?
  phone          String?
  role           Role                 @default(CUSTOMER)
  emailVerified  Boolean              @default(true)
  loyaltyPoints  Int                  @default(0)
  qrCode         String               @unique @default(cuid())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  orders         Order[]
  addresses      Address[]
  favorites      Favorite[]
  reviews        Review[]
  resetTokens    PasswordResetToken[]
  refreshTokens  RefreshToken[]
  emailConfirmTokens EmailConfirmationToken[]
  vapeProfile    VapeProfile?
  vapeRecommendations VapeRecommendation[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id               String      @id @default(cuid())
  sku              String?     @unique
  name             String
  /// Nom normalisé pour matching uniquement — jamais affiché tel quel au client
  normalizedName   String?
  slug             String      @unique
  description      String?
  category         String
  subcategory      String?
  brand            String?
  range            String?
  productType      String?
  categoryId       String?
  categoryRef      Category?   @relation(fields: [categoryId], references: [id])
  brandId          String?
  brandRef         Brand?      @relation(fields: [brandId], references: [id])
  imageUrl         String?
  images           String[]    @default([])
  priceCents       Int
  promoPriceCents  Int?
  currency         String      @default("EUR")
  /// Stock legacy e-commerce (agrégat) — les stocks boutiques sont dans StockLevel
  stock            Int         @default(0)
  salesCount       Int         @default(0)
  barcode          String?
  sumupProductId   String?
  sumupVariantId   String?
  source           String      @default("manual")
  visibleOnline    Boolean     @default(true)
  isActive         Boolean     @default(true)
  isNew            Boolean     @default(false)
  isBestSeller     Boolean     @default(false)
  isPromo          Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orderItems       OrderItem[]
  favorites        Favorite[]
  reviews          Review[]
  vapeRecommendations VapeRecommendation[]
  variants         ProductVariant[]
  flavors          ProductFlavor[]
  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  productMatches   ProductMatch[] @relation("MatchedProduct")

  @@index([isActive, category])
  @@index([isActive, isPromo])
  @@index([isActive, isBestSeller])
  @@index([isActive, isNew])
  @@index([salesCount])
  @@index([categoryId])
  @@index([brandId])
  @@index([normalizedName])
  @@index([barcode])
  @@index([sumupProductId])
  @@index([source])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  sku             String?
  barcode         String?
  nicotineMg      Float?
  nicotineLabel   String?
  powerWatts      Float?
  resistanceOhms  Float?
  capacityMl      Float?
  color           String?
  size            String?
  strength        String?
  sumupVariantId  String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]

  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@index([sumupVariantId])
}

model ProductFlavor {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  primaryFlavor    String?
  secondaryFlavor  String?
  flavorFamily     String?
  isFresh          Boolean?
  isFruity         Boolean?
  isGourmet        Boolean?
  isTobacco        Boolean?
  isMint           Boolean?
  isDrink          Boolean?
  confidenceScore  Float?
  validatedManually Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId])
  @@index([flavorFamily])
}

model StockLocation {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  levels    StockLevel[]
  movements StockMovement[]
}

model StockLevel {
  id                 String         @id @default(cuid())
  productId          String
  product            Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId          String
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId         String
  location           StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity           Int            @default(0)
  reservedQuantity   Int            @default(0)
  /// availableQuantity = quantity - reservedQuantity (maintenu à l'écriture)
  availableQuantity  Int            @default(0)
  lowStockThreshold  Int            @default(3)
  source             String         @default("unknown")
  lastSyncedAt       DateTime?
  updatedAt          DateTime       @updatedAt
  createdAt          DateTime       @default(now())

  @@unique([variantId, locationId])
  @@index([locationId])
  @@index([productId])
  @@index([availableQuantity])
}

model StockMovement {
  id                String         @id @default(cuid())
  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  locationId        String
  location          StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  movementType      String
  quantityBefore    Int
  quantityChange    Int
  quantityAfter     Int
  source            String
  externalReference String?
  createdAt         DateTime       @default(now())

  @@index([productId, createdAt])
  @@index([locationId, createdAt])
  @@index([movementType])
}

model ProductMatch {
  id                   String    @id @default(cuid())
  sourceType           String
  sourceProductId      String?
  sourceName           String
  normalizedSourceName String
  matchedProductId     String?
  matchedProduct       Product?  @relation("MatchedProduct", fields: [matchedProductId], references: [id], onDelete: SetNull)
  matchMethod          String?
  confidenceScore      Float?
  status               String    @default("UNMATCHED")
  validatedBy          String?
  validatedAt          DateTime?
  locationCode         String?
  syncRunId            String?
  syncRun              SyncRun?  @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  payloadSafe          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([normalizedSourceName])
  @@index([syncRunId])
  @@index([matchedProductId])
}

model SyncRun {
  id              String      @id @default(cuid())
  source          String
  locationCode    String?
  dryRun          Boolean     @default(true)
  startedAt       DateTime    @default(now())
  completedAt     DateTime?
  status          String      @default("RUNNING")
  importedCount   Int         @default(0)
  updatedCount    Int         @default(0)
  unchangedCount  Int         @default(0)
  unmatchedCount  Int         @default(0)
  duplicateCount  Int         @default(0)
  errorCount      Int         @default(0)
  createCount     Int         @default(0)
  errorSummary    String?
  reportJson      String?
  matches         ProductMatch[]
  errors          SyncError[]
}

model SyncError {
  id              String   @id @default(cuid())
  syncRunId       String
  syncRun         SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  sourceRow       Int?
  sourceReference String?
  errorType       String
  errorMessage    String
  payloadSafe     String?
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([syncRunId])
  @@index([resolved])
}

model VapeProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                String    @default("debutant")
  cigarettesPerDay      Int?
  drawPreference        String?
  preferredFlavors      String[]  @default([])
  avoidedFlavors        String[]  @default([])
  advisedNicotineMg     Int?
  usedNicotineMg        Int?
  advisedProductIds     String[]  @default([])
  triedProductIds       String[]  @default([])
  averageBudgetCents    Int?
  gdprConsent           Boolean   @default(false)
  personalizedEnabled   Boolean   @default(true)
  lastRecommendationAt  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model VapeRecommendation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  reason    String
  score     Float?
  source    String   @default("engine")
  createdAt DateTime @default(now())
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Domicile")
  firstName  String
  lastName   String
  street     String
  city       String
  postalCode String
  country    String   @default("FR")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  discountType   DiscountType
  value          Int
  minOrderCents  Int          @default(0)
  maxUses        Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  placement String   @default("home")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EmailConfirmationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Order {
  id                String          @id @default(cuid())
  userId            String?
  user              User?           @relation(fields: [userId], references: [id])
  customerEmail     String
  customerName      String?
  status            OrderStatus     @default(PENDING)
  totalCents        Int
  discountCents     Int             @default(0)
  shippingCents     Int             @default(0)
  couponCode        String?
  deliveryMethod    DeliveryMethod?
  pickupStoreId     String?
  shippingAddress   String?
  trackingNumber    String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  checkoutToken     String?         @unique
  paymentProvider   PaymentProvider?
  sumupCheckoutId   String?         @unique
  sumupPaymentId    String?
  vivaOrderCode     String?         @unique
  vivaTransactionId String?
  loyaltyPointsUsed Int             @default(0)
  loyaltyPointsEarn Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             OrderItem[]

  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([userId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  priceCents Int
}
