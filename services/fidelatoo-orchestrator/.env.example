# Copier vers .env sur la machine privée (jamais committer le vrai .env)
# Le secret doit être IDENTIQUE à FIDELATOO_ORCHESTRATOR_SECRET sur Vercel.

PORT=8787
HOST=127.0.0.1
FIDELATOO_ORCHESTRATOR_SECRET=

# Identité compte collaboratrice (mot de passe UNIQUEMENT dans le coffre hôte, pas ici)
FIDELATOO_AVA_ACCOUNT_EMAIL=avaallvaps@gmail.com

# Package Android Fidelatoo commerçant (à confirmer sur la machine via: adb shell pm list packages | findstr -i fidel)
FIDELATOO_ANDROID_PACKAGE=com.fidelatoo.pro

# AVD / émulateur optionnel (si VM Android locale)
# ANDROID_AVD_NAME=AllVaps_Fidelatoo
# ADB_PATH=C:\Users\...\platform-tools\adb.exe

# Durées
COMMAND_MAX_SKEW_SEC=90
QR_TTL_SEC=120
