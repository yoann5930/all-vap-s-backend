{
  "name": "all-vaps",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "catalog:test": "tsx scripts/catalog-professional-tests.ts",
    "catalog:export": "tsx scripts/catalog-export.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "catalog:liquidarom:dry-run": "tsx scripts/import-liquidarom-products.ts --dry-run",
    "catalog:liquidarom:import": "tsx scripts/import-liquidarom-products.ts",
    "catalog:liquidarom:enrich": "tsx scripts/enrich-liquidarom-csv.ts",
    "catalog:liquidarom:fetch-images": "tsx scripts/fetch-liquidarom-official-images.ts",
    "catalog:liquidarom:audit": "tsx scripts/audit-liquidarom.ts",
    "sumup:test": "tsx scripts/sumup-sync-tests.ts",
    "sumup:test-connection": "tsx scripts/sumup-test-connection.ts",
    "sumup:dry-run": "tsx scripts/sumup-dry-run.ts",
    "sumup:sync-once": "tsx scripts/sumup-sync-once.ts",
    "sumup:worker": "tsx scripts/sumup-worker.ts",
    "validate:sumup": "npm run sumup:test && npm run catalog:test && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.2",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^15.5.22",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.6.0",
    "three": "^0.185.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "playwright": "^1.49.1",
    "prisma": "^6.1.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
