NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allvaps_stock

# SumUp: use a server-side API key for one merchant account.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_POLL_INTERVAL_SECONDS=60
SUMUP_HISTORY_PAGE_SIZE=100
SUMUP_SYNC_START_AT=2026-01-01T00:00:00.000Z

# Important: public SumUp docs currently expose transaction/receipt reads,
# but no documented catalogue/inventory write endpoint.
SUMUP_CATALOG_MODE=csv
SUMUP_STOCK_WRITE_MODE=disabled

# Web shop / Viva.com integration
WEBHOOK_SHARED_SECRET=change-me
VIVA_WEBHOOK_SECRET=

# Safety
ALLOW_NEGATIVE_STOCK=false
RESERVATION_TTL_MINUTES=15
