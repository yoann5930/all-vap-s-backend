# Mode démo — données locales sans PostgreSQL (opt-in uniquement : DEMO_MODE=true)
# Par défaut (variable absente ou autre valeur) → PostgreSQL via DATABASE_URL
# Attention Windows : si DEMO_MODE existe déjà dans les variables système, elle écrase ce fichier.
# Contournement : $env:DEMO_MODE="false"; npm run dev
DEMO_MODE="false"

# PostgreSQL local (docker compose up -d → port 5433)
DATABASE_URL="postgresql://allvaps:allvaps@localhost:5433/allvaps?schema=public"

NODE_ENV="development"

# Domaine officiel — obligatoire en production :
# NEXT_PUBLIC_APP_URL="https://www.allvaps.fr"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Origines CSRF (CSV). www + apex allvaps.fr sont déjà inclus côté code.
ALLOWED_ORIGINS=""

JWT_SECRET="change-me-in-production-use-a-long-random-string"
# Mot de passe admin au seed — obligatoire hors localhost en production
SEED_ADMIN_PASSWORD=""

# Google Search Console — balise meta verification (Search Console > Paramètres > Propriété)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Google Analytics 4 — ID de mesure (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Merchant Center — compte marchand (configuration API / flux produits)
GOOGLE_MERCHANT_CENTER_ID=""

# Stock / SumUp — alertes + sync
STOCK_ALERT_EMAIL=allvaps70@gmail.com
STOCK_LOW_ALERT_THRESHOLD=5
STOCK_NOTIFY_ENABLED=false

# SumUp — paiement + synchronisation stock API
SUMUP_API_KEY=""
SUMUP_MERCHANT_CODE=""
SUMUP_API_BASE_URL=https://api.sumup.com
SUMUP_SYNC_ENABLED=false
SUMUP_SYNC_INTERVAL_SECONDS=1800
SUMUP_SYNC_OVERLAP_MINUTES=10
# Catalogue : CSV export officiel uniquement (pas d'API catalogue publique)
SUMUP_CATALOG_MODE=csv
# Écriture stock SumUp : disabled tant qu'aucune API officielle documentée
# Ne JAMAIS passer à partner_official sans accès partenaire SumUp explicite
SUMUP_STOCK_WRITE_MODE=disabled
ALLOW_NEGATIVE_STOCK=false
# Dossier pour déposer l’export Articles SumUp (items-export CSV)
SUMUP_INBOX_PATH=./inbox_sumup
# Push noms/images → SumUp (CSV outbox). URL HTTPS publique pour que SumUp télécharge les photos.
# SUMUP_PUSH_PUBLIC_BASE_URL=https://www.allvaps.fr
SUMUP_OUTBOX_PATH=./outbox_sumup
# Secret pour cron externe (Render cron, GitHub Actions…) — jamais côté client
CRON_SECRET=""
CATALOGUE_MAGASIN_PATH=./catalogues/catalogue-magasin-all-vaps.csv
CATALOGUE_AVA_PATH=./catalogues/catalogue-ava-all-vaps.csv
# Secret HMAC webhook (header x-payload-signature) — obligatoire en prod
SUMUP_WEBHOOK_SECRET=""
# Stock général unique GLOBAL_ALL_VAPS (PostgreSQL = source officielle).
# Les CSV catalogues/ sont des exports — pas la source de vérité.

# Viva.com
VIVA_CLIENT_ID=""
VIVA_CLIENT_SECRET=""
VIVA_MERCHANT_ID=""
# Viva.com — PRODUCTION : https://api.vivapayments.com (NE PAS laisser demo-api en prod)
# Sandbox / démo : https://demo-api.vivapayments.com
VIVA_API_URL="https://demo-api.vivapayments.com"
VIVA_SOURCE_CODE="Default"
# Clé auth webhook Viva (Authorization Bearer) — fortement recommandé en prod
VIVA_WEBHOOK_KEY=""
VIVA_WEBHOOK_VERIFICATION_KEY=""

# Paiement mode test — parcours checkout sans clés marchandes (local/CI uniquement)
# EN PRODUCTION RÉELLE : "false" + credentials Viva live renseignés
PAYMENT_TEST_MODE="true"
# Passerelle internet active côté serveur (jamais exposée au client) : viva | sumup
PAYMENT_ONLINE_PROVIDER="viva"
# Autoriser SumUp checkout web uniquement si explicitement activé (défaut: non)
PAYMENT_ALLOW_SUMUP_FALLBACK="false"

# Admin — e-mail fixe allvaps70@gmail.com ; mot de passe UNIQUEMENT via env :
# ADMIN_INITIAL_PASSWORD="…" npx tsx scripts/bootstrap-admin.ts
ADMIN_INITIAL_PASSWORD=""
SEED_ADMIN_PASSWORD=""

# Gmail API (classement libellés A.V.A.) — optionnel tant que non fourni
GOOGLE_GMAIL_CLIENT_ID=""
GOOGLE_GMAIL_CLIENT_SECRET=""
GOOGLE_GMAIL_REFRESH_TOKEN=""

# Shipping — Mondial Relay / Relais Colis uniquement (La Poste EXCLUE)
# Sans clé API : mode assisté (préparation données + import étiquette officielle).
# Avec clé : branchement HTTP officiel requis — aucun tracking inventé.
MONDIAL_RELAY_API_KEY=""
RELAIS_COLIS_API_KEY=""
# COLISSIMO / La Poste : ne pas utiliser — exclus du checkout
# COLISSIMO_API_KEY=""

# Boîte archive A.V.A. (BC + factures). Défaut = MAIL_FROM_ADDRESS.
# Si identique au gérant : un seul envoi SMTP + double marquage mémoire.
AVA_ARCHIVE_EMAIL=""

# Fidèle à Tout — laisser vide tant que le compte All Vap's n'est pas créé
# Voir docs/FIDELE_A_TOUT.md pour la checklist d'accès
FIDELE_A_TOUT_ENABLED=false
# true = aucun point local : uniquement sync Fidèle à Tout (une fois l'API branchée)
FIDELE_A_TOUT_SYNC_REQUIRED=false
FIDELE_A_TOUT_TEST_MODE=true
FIDELE_A_TOUT_API_URL=""
FIDELE_A_TOUT_API_KEY=""
FIDELE_A_TOUT_MERCHANT_ID=""
FIDELE_A_TOUT_ANDROID_PACKAGE=""

# AI (future)
AI_PROVIDER="stub"

# OpenAI — chat texte Ava uniquement (optionnel)
# La voix d'Ava utilise exclusivement speechSynthesis du navigateur (gratuit).
# Ne pas configurer de variables OPENAI_TTS_* — aucun appel /v1/audio/speech.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# A.V.A. — conversation vocale continue + recherche catalogue (pas de secrets)
AVA_VOICE_CONTINUOUS_MODE=true
AVA_AUTO_RESUME_LISTENING=true
AVA_SPEECH_END_SILENCE_MS=2000
AVA_MAX_USER_PAUSE_MS=10000
AVA_POST_TTS_ECHO_DELAY_MS=500
AVA_BARGE_IN_ENABLED=false
AVA_PRODUCT_SEARCH_ENABLED=true
AVA_MAX_PRODUCT_RESULTS=3
AVA_ONLY_IN_STOCK_PRODUCTS=true

# ─── Mode AUDIT_ONLY (serveur) ───
# Jamais true en production permanente. Activation aussi via /api/admin/audit-mode.
AUDIT_MODE_ENABLED=false
AUDIT_MODE_SECRET=
AUDIT_CAMPAIGN_ID=
AUDIT_MODE_EXPIRES_AT=

# ─── A.V.A. Gestion & rapports ───
AVA_MANAGEMENT_ENABLED=true
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TIME=20:30
DAILY_REPORT_TIMEZONE=Europe/Paris
DAILY_REPORT_RECIPIENT=allvaps70@gmail.com
DAILY_REPORT_PDF_ENABLED=true

# ─── Notifications (architecture) ───
NOTIFICATIONS_ENABLED=true
PUSH_PROVIDER=
PUSH_ENABLED=false
PUSH_SERVER_KEY=
PUSH_PROJECT_ID=

SMS_PROVIDER=android_gateway
SMS_ENABLED=false
SMS_OWNER_PHONE=
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=

ANDROID_GATEWAY_ENABLED=false
ANDROID_GATEWAY_API_URL=
ANDROID_GATEWAY_DEVICE_ID=
ANDROID_GATEWAY_SECRET=

# Email — A.V.A. (Gmail / SMTP) — secrets UNIQUEMENT dans .env.local (jamais ici)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=avaallvaps@gmail.com
# Mot de passe d'application Google — laisser vide ici ; renseigner dans .env.local
SMTP_APP_PASSWORD=
# Alias legacy (même valeur que SMTP_APP_PASSWORD si utilisé)
SMTP_PASS=
MAIL_FROM_NAME=A.V.A. — All Vap's
MAIL_FROM_ADDRESS=avaallvaps@gmail.com
MAIL_REPLY_TO=avaallvaps@gmail.com
MAIL_ENABLED=true
MAIL_TEST_MODE=true
MAIL_TEST_RECIPIENT=
ADMIN_NOTIFICATION_EMAIL=
ADMIN_NOTIFY_EMAIL=
APP_PUBLIC_URL=http://localhost:3000
LOYALTY_EMAILS_ENABLED=false
# auto | smtp | resend | console — préférer smtp avec Gmail A.V.A.
EMAIL_TRANSPORT=smtp
# Optionnel (fallback) — laisser vide si Gmail SMTP est utilisé
EMAIL_FROM="A.V.A. — All Vap's <avaallvaps@gmail.com>"
RESEND_API_KEY=""

# Identité légale — documents PDF (BC / facture / préparation)
COMPANY_LEGAL_NAME="ALL VAP'S"
COMPANY_ADDRESS="17 Avenue Marcel Aimé, 59330 Hautmont, France"
COMPANY_SIRET=""
COMPANY_EMAIL="contact@allvaps.fr"
COMPANY_PHONE=""

# Mode maintenance public (visiteurs → /maintenance)
# true = site public en maintenance. Localhost reste accessible sauf si FORCE_LOCAL=true.
# Accès propriétaire :
#   1) Compte ADMIN connecté (cookie session)
#   2) Une fois : https://www.allvaps.fr/?mt_bypass=VOTRE_SECRET (cookie 30 jours)
#   3) /login reste accessible pendant la maintenance
MAINTENANCE_MODE="false"
NEXT_PUBLIC_MAINTENANCE_MODE="false"
MAINTENANCE_FORCE_LOCAL="false"
MAINTENANCE_BYPASS_SECRET=""
